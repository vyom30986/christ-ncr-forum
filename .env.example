# ---- Client (Vite) ----
# Supabase project URL and anon (publishable) key. Safe to expose in the browser.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---- Edge Function secrets (set with `supabase secrets set`, NEVER in the client) ----
# GEMINI_API_KEY=...            # Google AI Studio key, used only by supabase/functions/ai-review
# RESEND_API_KEY=...            # Resend key, used only by supabase/functions/notify-status
# RESEND_FROM="CU C/S <cs@yourdomain.com>"
# ESCALATION_EMAILS=pratham@christuniversity.in,facilities@christuniversity.in   # people in charge, emailed on escalation (admins always are)
# APP_URL=https://christ-ncr-forum.vercel.app   # used to build links in notification emails
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase.

# Preview the UI with sample data and no backend (never set this in production)
# VITE_DEMO=1
